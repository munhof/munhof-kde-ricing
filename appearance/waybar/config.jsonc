[
  {
    "name": "rice-topbar",
    "layer": "top",
    "position": "top",
    "height": 42,
    "spacing": 8,
    "margin-top": 10,
    "margin-left": 16,
    "margin-right": 16,
    "modules-left": [
      "custom/launcher",
      "custom/desktops"
    ],
    "modules-center": [
      "custom/identity"
    ],
    "modules-right": [
      "pulseaudio",
      "network",
      "battery",
      "clock"
    ],
    "custom/launcher": {
      "format": "󰣇",
      "tooltip": "Abrir lanzador Wofi",
      "on-click": "$HOME/.local/bin/munhof-rice-appearance launcher"
    },
    "custom/desktops": {
      "exec": "$HOME/.local/bin/munhof-rice-appearance desktops",
      "interval": 2,
      "return-type": "text",
      "on-click": "$HOME/.local/bin/munhof-rice-appearance next-desktop",
      "tooltip": "Clic: siguiente escritorio"
    },
    "custom/identity": {
      "format": "  PLASMA RICE",
      "tooltip": "KDE Plasma 6 · KWin Wayland"
    },
    "pulseaudio": {
      "format": "󰕾  {volume}%",
      "format-muted": "󰝟",
      "on-click": "pavucontrol",
      "tooltip": true
    },
    "network": {
      "format-wifi": "󰖩",
      "format-ethernet": "󰈀",
      "format-disconnected": "󰖪",
      "tooltip-format": "{ifname} · {ipaddr}"
    },
    "battery": {
      "format": "󰁹  {capacity}%",
      "states": {
        "warning": 25,
        "critical": 15
      },
      "format-charging": "󰂄  {capacity}%",
      "format-plugged": "󰂄  {capacity}%"
    },
    "clock": {
      "format": "{:%a %d · %H:%M}",
      "tooltip-format": "{:%A %d de %B de %Y}"
    },
    "exclusive": true,
    "fixed-center": true
  },
  {
    "name": "rice-dock",
    "layer": "top",
    "position": "bottom",
    "height": 60,
    "spacing": 4,
    "margin-bottom": 12,
    "margin-left": 16,
    "margin-right": 16,
    "modules-center": [
      "custom/appmenu",
      "custom/terminal",
      "custom/browser",
      "custom/editor",
      "custom/files",
      "custom/runner"
    ],
    "custom/appmenu": {
      "format": "󰣇",
      "tooltip": "Aplicaciones",
      "on-click": "$HOME/.local/bin/munhof-rice-appearance launcher"
    },
    "custom/terminal": {
      "format": "",
      "tooltip": "Konsole",
      "on-click": "$HOME/.local/bin/munhof-rice-appearance launch terminal"
    },
    "custom/browser": {
      "format": "󰈹",
      "tooltip": "Navegador",
      "on-click": "$HOME/.local/bin/munhof-rice-appearance launch browser"
    },
    "custom/editor": {
      "format": "󰨞",
      "tooltip": "Editor de código",
      "on-click": "$HOME/.local/bin/munhof-rice-appearance launch editor"
    },
    "custom/files": {
      "format": "",
      "tooltip": "Dolphin",
      "on-click": "$HOME/.local/bin/munhof-rice-appearance launch files"
    },
    "custom/runner": {
      "format": "",
      "tooltip": "KRunner",
      "on-click": "$HOME/.local/bin/munhof-rice-appearance launch runner"
    },
    "exclusive": true,
    "fixed-center": true
  }
]
